# ---------------------------------------------------------------
#  git line-ending policy (keeps the repository consistent on Windows)
# ---------------------------------------------------------------
* text=auto eol=lf

*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.sh   text eol=lf

*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.zip  binary
